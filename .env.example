# QuickCart local development environment.
# Copy to .env (`make setup` does this). Never commit the copied .env.
# All values below are safe LOCAL development defaults only.

# --- Application ---
APP_ENV=local
LOG_LEVEL=INFO
QUICKCART_DATA_ROOT=./data
# Storage backend for the lakehouse (Phase 6 adds `s3`)
QUICKCART_STORAGE_BACKEND=local

# --- PostgreSQL (core profile) ---
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=quickcart
# Non-default local application user (the container superuser is this same user;
# local-dev simplification recorded in docs/learning/phase-1.md)
POSTGRES_USER=quickcart_app
POSTGRES_PASSWORD=quickcart_app_dev

# --- Streaming (Phase 7+) ---
REDPANDA_BOOTSTRAP_SERVERS=127.0.0.1:9092

# --- Object storage (Phase 6+, SeaweedFS S3 API) ---
S3_ENDPOINT=http://127.0.0.1:8333
S3_ACCESS_KEY=quickcart_dev
S3_SECRET_KEY=quickcart_dev_secret
S3_BUCKET=quickcart-lakehouse

# --- ML experiment tracking (Phase 11+) ---
MLFLOW_TRACKING_URI=http://127.0.0.1:5000

# --- AI stack (Phases 12-13+) ---
QDRANT_URL=http://127.0.0.1:6333
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Tool-capable local LLM; model choice is configuration, never hard-coded.
# Prefer a small tool-capable model on constrained hosts (e.g. 8GB EC2 demo).
# Locally you can override to qwen3:4b if you have the RAM.
OLLAMA_MODEL=qwen2.5:1.5b
