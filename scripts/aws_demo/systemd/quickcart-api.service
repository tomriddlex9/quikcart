[Unit]
Description=QuickCart FastAPI service
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/quikcart
EnvironmentFile=-/home/ubuntu/quikcart/.env
EnvironmentFile=-/home/ubuntu/quikcart/.env.aws-demo
Environment=PATH=/home/ubuntu/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=APP_HOST=0.0.0.0
ExecStart=/home/ubuntu/.local/bin/uv run python -m quickcart.api
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
