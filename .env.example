# QuickCart local development environment.
# Copy to .env (`make setup` does this). Never commit the copied .env.
# All values below are safe LOCAL development defaults only.

# --- Application ---
APP_ENV=local
LOG_LEVEL=INFO
QUICKCART_DATA_ROOT=./data
# Storage backend for the lakehouse (Phase 6 adds `s3`)
QUICKCART_STORAGE_BACKEND=local

# --- PostgreSQL (core profile) ---
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=quickcart
# Non-default local application user (the container superuser is this same user;
# local-dev simplification recorded in docs/learning/phase-1.md)
POSTGRES_USER=quickcart_app
POSTGRES_PASSWORD=quickcart_app_dev

# --- Streaming (Phase 7+) ---
REDPANDA_BOOTSTRAP_SERVERS=127.0.0.1:9092

# --- Object storage (Phase 6+, SeaweedFS S3 API) ---
S3_ENDPOINT=http://127.0.0.1:8333
S3_ACCESS_KEY=quickcart_dev
S3_SECRET_KEY=quickcart_dev_secret
S3_BUCKET=quickcart-lakehouse

# --- ML experiment tracking (Phase 11+) ---
MLFLOW_TRACKING_URI=http://127.0.0.1:5000

# --- AI stack (Phases 12-13+) ---
QDRANT_URL=http://127.0.0.1:6333
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Tool-capable local LLM; model choice is configuration, never hard-coded.
# Prefer a small tool-capable model on constrained hosts (e.g. 8GB EC2 demo).
# Locally you can override to qwen3:4b if you have the RAM.
OLLAMA_MODEL=qwen2.5:1.5b

# Assistant provider: grok (default) | gemini | auto
ASSISTANT_PROVIDER=grok
ASSISTANT_REQUIRE_CLOUD=false
# Background Spark/Gold cache warm (can OOM small machines). Off by default.
GOLD_WARMUP_ENABLED=false

# xAI Grok — paste your key here for the floating assistant / Ask / Agent.
# Get it: https://console.x.ai/ → API keys  (never NEXT_PUBLIC_*)
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-3-mini

# Google Gemini — only used when ASSISTANT_PROVIDER=gemini (or auto without XAI key).
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-3.8-flash
# Voice: Gemini Live when GEMINI_API_KEY is set; else Grok browser STT/TTS when XAI_API_KEY is set.
VOICE_ENABLED=true
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_LIVE_VOICE=Aoede

# Auth (Phase 16). auth_enforce=false keeps anonymous console demos working.
AUTH_SECRET=quickcart-dev-secret-change-me
AUTH_ENFORCE=false
DEMO_USER_PASSWORD=quickcart
